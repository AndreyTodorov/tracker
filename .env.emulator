# Loaded by `vite --mode emulator` (pnpm dev:emulator), in addition to .env.
# These are throwaway values for the Local Emulator Suite — the emulator does
# not validate them and never connects to a real Firebase project. They also
# override any real values in .env so emulator runs stay fully isolated.
VITE_USE_FIREBASE_EMULATOR=true

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tracker
VITE_FIREBASE_STORAGE_BUCKET=demo-tracker.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_DATABASE_URL=https://demo-tracker-default-rtdb.firebaseio.com
