{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'displayName'])",
        "email": { ".validate": "newData.isString()" },
        "displayName": { ".validate": "newData.isString()" },
        "id": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "shareCode": { ".validate": "newData.isString()" },
        "sharedPortfolios": {
          "$index": { ".validate": "newData.isString()" }
        },
        "$other": { ".validate": false }
      }
    },
    "investments": {
      ".read": "auth != null",
      ".indexOn": "userId",
      "$investmentId": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['userId', 'assetName', 'assetSymbol', 'buyPrice', 'quantity', 'currency'])",
        "userId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "userName": { ".validate": "newData.isString()" },
        "assetName": { ".validate": "newData.isString()" },
        "assetSymbol": { ".validate": "newData.isString()" },
        "coinId": { ".validate": "newData.isString()" },
        "buyPrice": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "investmentAmount": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "quantity": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "currency": { ".validate": "newData.isString()" },
        "purchaseDate": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "name": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
