{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'displayName'])",
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "id": { ".validate": "newData.isString() && newData.val() === $uid" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "shareCode": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8}$/)" },
        "sharedPortfolios": {
          "$ownerUid": {
            ".validate": "newData.isString() && root.child('shareCodeIndex').child(newData.val()).child('uid').val() === $ownerUid"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "shareCodeIndex": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid) && root.child('users').child(auth.uid).child('shareCode').val() === $code",
        ".validate": "newData.hasChildren(['uid', 'displayName']) && $code.matches(/^[A-Z0-9]{8}$/)",
        "uid": { ".validate": "newData.isString()" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "$other": { ".validate": false }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName'])",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "$other": { ".validate": false }
      }
    },
    "investments": {
      "$ownerUid": {
        ".read": "auth != null && (auth.uid === $ownerUid || root.child('publicProfiles').child($ownerUid).exists() || root.child('users').child(auth.uid).child('sharedPortfolios').child($ownerUid).exists())",
        "$investmentId": {
          ".write": "auth != null && auth.uid === $ownerUid",
          ".validate": "newData.hasChildren(['userId', 'assetName', 'assetSymbol', 'buyPrice', 'quantity', 'currency'])",
          "userId": { ".validate": "newData.isString() && newData.val() === $ownerUid" },
          "userName": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "assetName": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "assetSymbol": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "coinId": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "buyPrice": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "investmentAmount": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "quantity": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "currency": { ".validate": "newData.isString() && newData.val().matches(/^(USD|EUR|GBP|JPY|CHF|CAD|AUD)$/)" },
          "purchaseDate": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
