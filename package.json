    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.18",
