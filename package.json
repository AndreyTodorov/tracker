{
  "name": "tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "emulators:docker": "docker compose up",
    "dev:docker": "concurrently -n docker,vite -c blue,green \"docker compose up\" \"vite --mode emulator\""
  },
